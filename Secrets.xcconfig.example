// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in real values.
// Secrets.xcconfig is gitignored — NEVER commit actual keys.
//
// HOW TO WIRE THIS UP IN XCODE:
//   1. File → New → File → Configuration Settings File → name it "Secrets"
//   2. In Project Settings → Info → Configurations, set each target to "Secrets"
//   3. In Info.plist, add entries like: STRIPE_PUBLISHABLE_KEY = $(STRIPE_PUBLISHABLE_KEY)
//   4. Read in Swift: Bundle.main.object(forInfoDictionaryKey: "STRIPE_PUBLISHABLE_KEY") as? String
//
// SUPABASE KEYS — both are SAFE to embed in the app.
//   The anon key is publicly known by design; Row Level Security (RLS) is the actual guard.
//   See: https://supabase.com/docs/guides/auth/row-level-security
SUPABASE_URL = https://your-project-id.supabase.co
SUPABASE_ANON_KEY = eyJ...your_anon_key_here

// STRIPE PUBLISHABLE KEY — SAFE to embed in the app.
//   It can only initiate payment flows, not charge cards or read data.
//   The Stripe SECRET key MUST stay server-side (Supabase secret, never here).
STRIPE_PUBLISHABLE_KEY = pk_test_...your_test_publishable_key_here

// EDGE FUNCTION SECRETS — set these in the Supabase dashboard only.
//   supabase secrets set STRIPE_SECRET_KEY=sk_test_...
//   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
//   supabase secrets set STRIPE_PUBLISHABLE_KEY=pk_test_...
//   supabase secrets set APP_ORIGIN=https://yourapp.com
//   These are NEVER stored here or in any committed file.
